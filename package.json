{
  "name": "vue-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npx getcdn .dir=public/cdn fingerprintjs2@2.1.0 vconsole@3.15.0 zepto@1.2.0",
    "dev": "cross-env VUE_APP_ENV=dev vue-cli-service serve",
    "build": "cross-env VUE_APP_ENV=prod vue-cli-service build --report",
    "build:test": "cross-env VUE_APP_ENV=test vue-cli-service build --report",
    "start": "run-p serve mm",
    "lint": "vue-cli-service lint",
    "mm": "mockm --cwd=mm --dev"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "core-js": "^3.10.1",
    "dayjs": "^1.11.6",
    "fingerprintjs2": "^1.8.6",
    "flyio": "^0.6.4",
    "swiper": "3.4.2",
    "vue": "^2.7.14",
    "vue-baberrage": "2.1.9",
    "vue-dplayer": "0.0.10",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^4.5.12",
    "@vue/cli-plugin-eslint": "^4.5.12",
    "@vue/cli-plugin-router": "^4.5.12",
    "@vue/cli-plugin-vuex": "^4.5.12",
    "@vue/cli-service": "^4.5.12",
    "@vue/eslint-config-prettier": "^6.0.0",
    "babel-eslint": "^10.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^6.8.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-vue": "^6.2.2",
    "esm": "^3.2.25",
    "getcdn": "^0.0.1",
    "less": "^3.13.1",
    "less-loader": "^5.0.0",
    "mockm": "1.1.26-alpha.42",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.2.1",
    "style-resources-loader": "^1.4.1",
    "vue-cli-plugin-style-resources-loader": "^0.1.5",
    "vue-template-compiler": "^2.7.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/prettier"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "ignorePatterns": [
      ""
    ],
    "globals": {
      "AMap": "readonly",
      "$": "readonly"
    },
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "singleQuote": true,
          "semi": false
        }
      ],
      "semi": [
        "error",
        "never"
      ],
      "quotes": [
        "error",
        "backtick"
      ],
      "no-unused-vars": "off",
      "no-console": "off",
      "no-debugger": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
